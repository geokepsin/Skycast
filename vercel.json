{
  "framework": "vite",
  "rewrites": [
    { "source": "/api/geocode", "destination": "/api/geocode.ts" },
    { "source": "/api/weather", "destination": "/api/weather.ts" },
    { "source": "/api/summary", "destination": "/api/summary.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
